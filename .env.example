# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed
# template, so keep every key here with a safe placeholder value.

# ---------------------------------------------------------------------------
# Worktree identity and host ports
# ---------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME MUST equal this checkout's directory name. It namespaces
# the stack's containers, network, and volumes, so a worktree running in parallel
# stays fully independent — and `scripts/docker_common.py`-style tooling filters
# `docker ps` by it.
COMPOSE_PROJECT_NAME=productivity-tracker

# Every published port is `conventional_base + slot`, where this checkout's slot
# is 3. The registry that assigns slots is devkit's `ports.toml` — add a
# project there rather than picking a free-looking number by hand. Re-generate
# this block with: python <devkit>/scripts/devkit_ports.py productivity-tracker
APP_HOST_PORT=8003
DB_HOST_PORT=5435

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The host-side URL. It must agree with DB_HOST_PORT above — that is the pairing
# that breaks first when a worktree's ports are edited by hand.
DATABASE_URL=postgresql+psycopg://productivity_tra:productivity_tra_local_dev@127.0.0.1:5435/productivity_tracker
POSTGRES_USER=productivity_tra
POSTGRES_PASSWORD=productivity_tra_local_dev
POSTGRES_DB=productivity_tracker

# ---------------------------------------------------------------------------
# Tracker: the server, every PC's collector, and the laptop's overlay
# ---------------------------------------------------------------------------
# Where the collectors and the overlay reach the server. On the PC running it,
# the app's published port; on every other PC, that PC's address as they see it
# (a LAN or Tailscale name), e.g. http://desktop-b9fc8vp:8003.
TRACKER_URL=http://127.0.0.1:8003
# Shared secret every request carries as a bearer token. The server checks it
# whenever it is set; set the same value on every PC. Empty disables the check,
# which is only safe while the port is reachable from this PC alone.
TRACKER_TOKEN=change-me
# Collector only: set on a PC that is one task as a whole (e.g. itopia). Every
# session there reports under this name instead of its project's, so none of
# them lights a project row. Leave empty for rows per project. The row itself is yours to
# add: a name no row carries shows nowhere.
TRACKER_TASK=
# Overlay only: what you connect to in Remote Desktop, for any PC whose address there is not
# its own name: the window a click raises, and what it opens if there is none. JSON.
# e.g. {"DESKTOP-B9FC8VP": "100.76.121.58"}
TRACKER_RDP_TARGETS={}
# Server only: where your day starts and ends, for prompts per day, records and streaks.
# An IANA name (Postgres checks it at start-up).
TRACKER_TIMEZONE=America/New_York
# Seconds a PC may go without reporting before its sessions stop counting.
STALE_AFTER_SECONDS=30
COLLECT_INTERVAL_SECONDS=3
POLL_INTERVAL_SECONDS=2
# Claude Code's config directory, if not ~/.claude (CLAUDE_CONFIG_DIR is honoured).
# CLAUDE_CONFIG_DIR=

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Resource attributes. `service.instance.id` is what distinguishes two worktrees
# exporting to the same collector — without it their metrics silently merge.
OTEL_SERVICE_NAME=productivity-tracker
OTEL_RESOURCE_ATTRIBUTES=service.name=productivity-tracker,service.instance.id=productivity-tracker,deployment.environment=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
